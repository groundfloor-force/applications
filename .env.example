# Monday.com API Token (get from monday.com > Avatar > Admin > API)
MONDAY_API_TOKEN=your_monday_api_token_here

# Admin page password
ADMIN_PASSWORD=changeme

# Optional: email to notify on new application (not required for Monday integration)
NOTIFICATION_EMAIL=

# Anthropic API key — powers automated income verification of uploaded
# pay stubs. If unset, verification is skipped silently.
ANTHROPIC_API_KEY=

# Shared secret for the inbound support-email webhook. Callers (e.g.
# Make.com) must include this as either an X-Webhook-Secret header or
# ?secret=... query param. Any long random string is fine. If unset,
# /api/support/inbound rejects every request.
INBOUND_WEBHOOK_SECRET=
