# Monday.com API Token (get from monday.com > Avatar > Admin > API)
MONDAY_API_TOKEN=your_monday_api_token_here

# Admin page password
ADMIN_PASSWORD=changeme

# Optional: email to notify on new application (not required for Monday integration)
NOTIFICATION_EMAIL=

# Anthropic API key — powers automated income verification of uploaded
# pay stubs. If unset, verification is skipped silently.
ANTHROPIC_API_KEY=

# Shared secret for the inbound support-email webhook. Callers (e.g.
# Make.com) must include this as either an X-Webhook-Secret header or
# ?secret=... query param. Any long random string is fine. If unset,
# /api/support/inbound rejects every request.
INBOUND_WEBHOOK_SECRET=

# Lighthouse applications intake (dual-write alongside Monday).
# Use the same APPLICATIONS_INTAKE_SECRET as the Lighthouse Vercel project.
# Never expose either var to the client (no NEXT_PUBLIC_ prefix).
# If either is unset, intake is skipped and Monday submit still succeeds.
APPLICATIONS_INTAKE_SECRET=
# Full intake URL. Production:
#   https://groundfloor-force.vercel.app/api/applications/intake
# Local Lighthouse:
#   http://localhost:3000/api/applications/intake
APPLICATIONS_INTAKE_URL=https://groundfloor-force.vercel.app/api/applications/intake
